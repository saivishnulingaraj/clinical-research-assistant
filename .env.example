# ---------------------------------------------------------------------------
# clinical-research-assistant configuration.
# Copy to `.env` and adjust. NEVER commit a real `.env` (it is gitignored).
# All variables are prefixed with CRA_.
# ---------------------------------------------------------------------------

# LLM backend: "fake" (deterministic, used in tests/CI) or "bedrock" (real).
CRA_LLM_PROVIDER=fake

# --- Amazon Bedrock (only needed when CRA_LLM_PROVIDER=bedrock) -------------
# The model ID and region are read from here and are NEVER hard-coded.
CRA_BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
CRA_AWS_REGION=us-east-1
# Standard AWS credentials are picked up by boto3/langchain-aws from the
# environment or your AWS profile. Do NOT put secrets in this file.
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...

# --- Cost estimation (USD per 1,000 tokens) --------------------------------
CRA_PRICE_PER_1K_INPUT_USD=0.0008
CRA_PRICE_PER_1K_OUTPUT_USD=0.0032

# --- LLM limits & caching --------------------------------------------------
CRA_MAX_LLM_CALLS_PER_REQUEST=8
CRA_LLM_CACHE_SIZE=256
CRA_LLM_TEMPERATURE=0.0
CRA_LLM_MAX_TOKENS=1024

# --- Embeddings & vector store ---------------------------------------------
CRA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CRA_FAISS_INDEX_DIR=data/index

# --- Chunking --------------------------------------------------------------
CRA_CHUNK_SIZE=800
CRA_CHUNK_OVERLAP=120

# --- Retrieval -------------------------------------------------------------
CRA_RETRIEVAL_TOP_K=4
CRA_MAX_SUB_QUERIES=3
CRA_CONFIDENCE_THRESHOLD=0.30

# --- Misc ------------------------------------------------------------------
CRA_DATA_DIR=data
CRA_LOG_LEVEL=INFO
